<odoo>
 <record id="ppa_ingestion_event_view_list" model="ir.ui.view"><field name="name">ppa.ingestion.event.list</field><field name="model">ppa.ingestion.event</field><field name="arch" type="xml"><list><field name="received_at"/><field name="source_id"/><field name="mailbox_id"/><field name="event_type"/><field name="external_object_id"/><field name="message_id"/><field name="conversation_id"/><field name="status"/><field name="retry_count"/></list></field></record>
 <record id="ppa_ingestion_event_view_form" model="ir.ui.view"><field name="name">ppa.ingestion.event.form</field><field name="model">ppa.ingestion.event</field><field name="arch" type="xml"><form><header><button name="action_retry" type="object" string="Retry" invisible="status != 'failed'"/><field name="status" widget="statusbar"/></header><sheet><group><group><field name="source_id"/><field name="external_event_id"/><field name="external_object_id"/><field name="event_type"/><field name="meeting_id"/><field name="message_id"/><field name="conversation_id"/></group><group><field name="received_at"/><field name="processed_at"/><field name="retry_count"/><field name="error_message"/></group></group><notebook><page string="Payload"><field name="normalized_payload_json" nolabel="1"/><field name="raw_payload_json" nolabel="1"/></page></notebook></sheet></form></field></record>
 <record id="ppa_ingestion_event_view_search" model="ir.ui.view"><field name="name">ppa.ingestion.event.search</field><field name="model">ppa.ingestion.event</field><field name="arch" type="xml"><search><field name="external_event_id"/><field name="external_object_id"/><filter string="Email" name="email" domain="[('source_id.code','=','email')]"/><filter string="Received" name="received" domain="[('status','=','received')]"/><filter string="Completed" name="completed" domain="[('status','=','completed')]"/><filter string="Failed" name="failed" domain="[('status','=','failed')]"/><filter string="Ignored" name="ignored" domain="[('status','=','ignored')]"/><filter string="Plaud" name="plaud" domain="[('source_id.code','=','plaud')]"/><filter string="Today" name="today" domain="[('received_at','&gt;=',context_today())]"/><separator/><filter string="Source" name="group_source" context="{'group_by':'source_id'}"/><filter string="Event Type" name="group_event_type" context="{'group_by':'event_type'}"/><filter string="Status" name="group_status" context="{'group_by':'status'}"/><filter string="Meeting" name="group_meeting" context="{'group_by':'meeting_id'}"/><filter string="Message" name="group_message" context="{'group_by':'message_id'}"/><filter string="Received Date" name="group_received" context="{'group_by':'received_at:day'}"/></search></field></record>
 <record id="ppa_ingestion_event_action" model="ir.actions.act_window"><field name="name">Ingestion Events</field><field name="res_model">ppa.ingestion.event</field><field name="view_mode">list,form</field></record>
</odoo>
