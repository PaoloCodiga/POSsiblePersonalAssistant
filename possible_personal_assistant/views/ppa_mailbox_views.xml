<odoo>
 <record id="ppa_mailbox_view_list" model="ir.ui.view"><field name="name">ppa.mailbox.list</field><field name="model">ppa.mailbox</field><field name="arch" type="xml"><list><field name="name"/><field name="email_address"/><field name="protocol"/><field name="imap_host"/><field name="folder"/><field name="active"/><field name="sync_state"/><field name="last_sync_at"/><field name="last_success_at"/></list></field></record>
 <record id="ppa_mailbox_view_form" model="ir.ui.view"><field name="name">ppa.mailbox.form</field><field name="model">ppa.mailbox</field><field name="arch" type="xml"><form><header><button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/><button name="action_initialize_current_inbox" type="object" string="Initialize From Current Inbox" confirm="This records the current highest UID and imports no historical messages. Continue?"/><button name="action_sync_now" type="object" string="Sync Now"/><field name="sync_state" widget="statusbar"/></header><sheet><group string="Identity"><field name="name"/><field name="active"/><field name="email_address"/><field name="company_id"/></group><group string="Connection"><field name="protocol"/><field name="imap_host"/><field name="imap_port"/><field name="imap_ssl"/><field name="imap_starttls"/><field name="username"/><field name="password" widget="password" placeholder="Enter a replacement password"/></group><group string="Synchronization"><field name="folder"/><field name="poll_interval_minutes"/><field name="last_sync_at" readonly="1"/><field name="last_success_at" readonly="1"/><field name="uid_validity" readonly="1"/><field name="last_uid" readonly="1"/></group><group string="Defaults"><field name="default_owner_id"/><field name="default_project_id"/><field name="default_flow_id"/></group><group string="Diagnostics"><field name="sync_state" readonly="1"/><field name="last_error" readonly="1"/></group></sheet></form></field></record>
 <record id="ppa_mailbox_view_search" model="ir.ui.view"><field name="name">ppa.mailbox.search</field><field name="model">ppa.mailbox</field><field name="arch" type="xml"><search><field name="name"/><field name="email_address"/><filter name="active" string="Active" domain="[('active','=',True)]"/><filter name="error" string="Errors" domain="[('sync_state','=','error')]"/><filter name="company" string="By Company" context="{'group_by':'company_id'}"/></search></field></record>
 <record id="ppa_mailbox_action" model="ir.actions.act_window"><field name="name">Mailboxes</field><field name="res_model">ppa.mailbox</field><field name="view_mode">list,form</field></record>
</odoo>
