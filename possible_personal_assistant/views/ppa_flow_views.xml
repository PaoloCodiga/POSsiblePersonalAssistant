<odoo>
 <record id="ppa_flow_view_list" model="ir.ui.view"><field name="name">ppa.flow.list</field><field name="model">ppa.flow</field><field name="arch" type="xml"><list><field name="name"/><field name="state"/><field name="priority"/><field name="owner_id"/><field name="project_id"/><field name="company_id"/><field name="last_activity_at"/></list></field></record>
 <record id="ppa_flow_view_form" model="ir.ui.view"><field name="name">ppa.flow.form</field><field name="model">ppa.flow</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="state"/><field name="priority"/><field name="owner_id"/><field name="company_id"/><field name="project_id"/><field name="external_reference"/><field name="first_activity_at" readonly="1"/><field name="last_activity_at" readonly="1"/></group><field name="description"/><notebook><page string="Conversations"><field name="conversation_ids"><list><field name="name"/><field name="operational_state"/><field name="project_id"/><field name="last_message_at"/></list></field></page><page string="Open Actions"><field name="work_item_ids"><list><field name="priority"/><field name="name"/><field name="suggested_user_id"/><field name="state"/><field name="due_date"/><field name="source_category"/></list></field></page></notebook></sheet><chatter/></form></field></record>
 <record id="ppa_flow_view_search" model="ir.ui.view"><field name="name">ppa.flow.search</field><field name="model">ppa.flow</field><field name="arch" type="xml"><search><field name="name"/><field name="project_id"/><field name="company_id"/><filter name="my_flows" string="My Flows" domain="[('owner_id','=',uid)]"/><filter name="open" string="Open" domain="[('state','=','open')]"/><filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/><filter name="waiting" string="Waiting" domain="[('state','=','waiting')]"/><filter name="resolved" string="Resolved" domain="[('state','=','resolved')]"/><filter name="critical" string="Critical" domain="[('priority','=','critical')]"/><filter name="important" string="Important" domain="[('priority','=','important')]"/><filter name="by_project" string="By Project" context="{'group_by':'project_id'}"/><filter name="by_company" string="By Company" context="{'group_by':'company_id'}"/></search></field></record>
 <record id="ppa_flow_action" model="ir.actions.act_window"><field name="name">Flows</field><field name="res_model">ppa.flow</field><field name="view_mode">list,form,pivot,graph</field></record>
</odoo>
