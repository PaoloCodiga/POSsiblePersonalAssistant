<odoo>
 <record id="ppa_suggested_action_view_list" model="ir.ui.view"><field name="name">ppa.suggested.action.list</field><field name="model">ppa.suggested.action</field><field name="arch" type="xml"><list><field name="name"/><field name="suggested_user_id"/><field name="priority"/><field name="state"/><field name="due_date"/><field name="project_id"/></list></field></record>
 <record id="ppa_suggested_action_view_form" model="ir.ui.view"><field name="name">ppa.suggested.action.form</field><field name="model">ppa.suggested.action</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirm" invisible="state != 'to_confirm'"/><button name="action_reject" type="object" string="Reject" invisible="state != 'to_confirm'"/><button name="action_start" type="object" string="Start" invisible="state != 'confirmed'"/><button name="action_mark_done" type="object" string="Mark Done" invisible="state not in ('confirmed','in_progress')"/><button name="action_reopen" type="object" string="Reopen" invisible="state not in ('completed','rejected')"/><field name="state" widget="statusbar" statusbar_visible="to_confirm,confirmed,in_progress,completed,rejected"/></header><sheet><group><group><field name="name"/><field name="description"/><field name="suggested_user_id"/><field name="partner_id"/><field name="company_id"/><field name="project_id"/><field name="priority"/><field name="due_date"/></group><group><field name="ai_confidence"/><field name="ai_reason"/><field name="source_type"/><field name="source_message_id" invisible="source_type != 'message'"/><field name="source_meeting_id" invisible="source_type != 'meeting'"/><field name="confirmed_action_type" readonly="1"/><field name="confirmed_task_id" readonly="1"/><field name="confirmed_activity_id" readonly="1"/></group></group></sheet><chatter/></form></field></record>
 <record id="ppa_suggested_action_view_search" model="ir.ui.view"><field name="name">ppa.suggested.action.search</field><field name="model">ppa.suggested.action</field><field name="arch" type="xml"><search><field name="name"/><filter name="my_actions" string="My Actions" domain="[('suggested_user_id', '=', uid)]"/><filter name="today" string="Today" domain="[('due_date', '&gt;=', context_today()), ('due_date', '&lt;', context_today() + relativedelta(days=1))]"/><filter name="overdue" string="Overdue" domain="[('due_date', '&lt;', context_today()), ('state', 'not in', ('completed', 'rejected'))]"/><filter name="critical" string="Critical" domain="[('priority', '=', 'critical')]"/><filter name="important" string="Important" domain="[('priority', '=', 'important')]"/><filter name="to_confirm" string="To Confirm" domain="[('state', '=', 'to_confirm')]"/><filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/><filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/><filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/><filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/></search></field></record>
 <record id="ppa_suggested_action_action" model="ir.actions.act_window"><field name="name">All Actions</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">list,form,pivot,graph</field></record>
</odoo>
