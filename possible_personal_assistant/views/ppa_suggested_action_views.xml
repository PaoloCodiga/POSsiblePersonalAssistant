<odoo>
 <record id="ppa_suggested_action_view_list" model="ir.ui.view"><field name="name">ppa.suggested.action.list</field><field name="model">ppa.suggested.action</field><field name="arch" type="xml"><list><field name="priority"/><field name="name"/><field name="suggested_user_id"/><field name="state"/><field name="due_date"/><field name="flow_id"/><field name="project_id"/><field name="source_category"/><field name="company_id"/></list></field></record>
 <record id="ppa_suggested_action_view_form" model="ir.ui.view"><field name="name">ppa.suggested.action.form</field><field name="model">ppa.suggested.action</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirm" invisible="state != 'to_confirm'"/><button name="action_reject" type="object" string="Reject" invisible="state != 'to_confirm'"/><button name="action_start" type="object" string="Start Work" invisible="state != 'confirmed'"/><button name="action_set_waiting" type="object" string="Set Waiting" invisible="state not in ('confirmed','in_progress')"/><button name="action_resume" type="object" string="Resume" invisible="state != 'waiting'"/><button name="action_mark_done" type="object" string="Complete" invisible="state not in ('confirmed','in_progress','waiting')"/><button name="action_reopen" type="object" string="Reopen" invisible="state not in ('completed','rejected')"/><field name="state" widget="statusbar" statusbar_visible="to_confirm,confirmed,in_progress,waiting,completed,rejected"/></header><sheet><group><group><field name="name"/><field name="description"/><field name="suggested_user_id"/><field name="partner_id"/><field name="company_id"/><field name="flow_id"/><field name="project_id"/><field name="priority"/><field name="due_date"/><field name="raw_deadline_text"/></group><group><field name="source_category" readonly="1"/><field name="source_type"/><field name="source_message_id" invisible="source_type != 'message'"/><field name="source_meeting_id" invisible="source_type != 'meeting'"/><field name="ai_analysis_id" readonly="1"/><field name="ai_confidence" readonly="1"/><field name="suggested_user_text" readonly="1"/><field name="ai_reason" readonly="1"/><field name="waiting_reason" invisible="state != 'waiting'"/><field name="waiting_on_text" invisible="state != 'waiting'"/><field name="waiting_since" readonly="1" invisible="state != 'waiting'"/><field name="confirmed_action_type" readonly="1"/><field name="confirmed_task_id" readonly="1"/><field name="confirmed_activity_id" readonly="1"/></group></group></sheet><chatter/></form></field></record>
 <record id="ppa_suggested_action_view_search" model="ir.ui.view"><field name="name">ppa.suggested.action.search</field><field name="model">ppa.suggested.action</field><field name="arch" type="xml"><search><field name="name"/><filter name="my_actions" string="My Work" domain="[('suggested_user_id', '=', uid)]"/><filter name="today" string="Today" domain="[('due_date', '&gt;=', context_today()), ('due_date', '&lt;', context_today() + relativedelta(days=1))]"/><filter name="overdue" string="Overdue" domain="[('due_date', '&lt;', context_today()), ('state', 'not in', ('completed', 'rejected'))]"/><filter name="critical" string="Critical" domain="[('priority', '=', 'critical')]"/><filter name="important" string="Important" domain="[('priority', '=', 'important')]"/><filter name="waiting" string="Waiting" domain="[('state','=','waiting')]"/><filter name="unassigned_owner" string="Unassigned Owner" domain="[('suggested_user_id','=',False)]"/><filter name="unassigned_flow" string="Unassigned Flow" domain="[('flow_id','=',False)]"/><filter name="unassigned_project" string="Unassigned Project" domain="[('project_id','=',False)]"/><filter name="email" string="Email" domain="[('source_category','=','email')]"/><filter name="meeting" string="Meeting" domain="[('source_category','=','meeting')]"/><filter name="to_confirm" string="To Confirm" domain="[('state', '=', 'to_confirm')]"/><filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/><filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/><separator/><filter name="group_owner" string="Owner" context="{'group_by':'suggested_user_id'}"/><filter name="group_flow" string="Flow" context="{'group_by':'flow_id'}"/><filter name="group_project" string="Project" context="{'group_by':'project_id'}"/><filter name="group_source" string="Source" context="{'group_by':'source_category'}"/></search></field></record>
 <record id="ppa_suggested_action_action" model="ir.actions.act_window"><field name="name">All Actions</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">list,form,pivot,graph</field></record>
 <record id="ppa_global_work_queue_action" model="ir.actions.act_window"><field name="name">Global Work Queue</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">list,form</field><field name="domain">[('state','not in',('completed','rejected'))]</field></record>
 <record id="ppa_my_work_queue_action" model="ir.actions.act_window"><field name="name">My Work</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">list,form</field><field name="domain">[('suggested_user_id','=',uid),('state','not in',('completed','rejected'))]</field></record>
 <record id="ppa_waiting_work_action" model="ir.actions.act_window"><field name="name">Waiting</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">list,form</field><field name="domain">[('state','=','waiting')]</field></record>
 <record id="ppa_completed_work_action" model="ir.actions.act_window"><field name="name">Completed</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">list,form</field><field name="domain">[('state','=','completed')]</field></record>
</odoo>
