<odoo>
    <record id="ppa_message_view_list" model="ir.ui.view">
        <field name="name">ppa.message.list</field><field name="model">ppa.message</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="source_id"/><field name="subject"/><field name="sender_name"/><field name="direction"/><field name="received_at"/><field name="requires_action"/></list></field>
    </record>
    <record id="ppa_message_view_form" model="ir.ui.view">
        <field name="name">ppa.message.form</field><field name="model">ppa.message</field>
        <field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="source_id"/><field name="external_id"/><field name="conversation_id"/><field name="sender_name"/><field name="sender_address"/><field name="direction"/></group><group><field name="subject"/><field name="received_at"/><field name="sent_at"/><field name="partner_id"/><field name="company_id"/><field name="project_id"/><field name="requires_reply"/><field name="requires_action"/></group></group><notebook><page string="Content"><field name="body"/></page><page string="AI"><field name="ai_summary"/><field name="ai_category"/><field name="ai_importance"/><field name="ai_confidence"/></page><page string="Technical" groups="possible_personal_assistant.group_ppa_manager"><field name="raw_payload_json"/></page></notebook></sheet><chatter/></form></field>
    </record>
    <record id="ppa_message_view_search" model="ir.ui.view">
        <field name="name">ppa.message.search</field><field name="model">ppa.message</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="subject"/><field name="source_id"/><filter name="incoming" string="Incoming" domain="[('direction', '=', 'incoming')]"/><filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/><filter name="requires_reply" string="Requires Reply" domain="[('requires_reply', '=', True)]"/><filter name="requires_action" string="Requires Action" domain="[('requires_action', '=', True)]"/><filter name="ai_processed" string="AI Processed" domain="[('ai_processed', '=', True)]"/><filter name="my_company" string="My Company" domain="[('company_id', '=', company_id)]"/><group><filter name="group_source" string="Source" context="{'group_by': 'source_id'}"/><filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/><filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/><filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/><filter name="group_conversation" string="Conversation" context="{'group_by': 'conversation_id'}"/><filter name="group_received_at" string="Received Date" context="{'group_by': 'received_at:day'}"/></group></search></field>
    </record>
    <record id="ppa_message_action" model="ir.actions.act_window"><field name="name">Messages</field><field name="res_model">ppa.message</field><field name="view_mode">list,form,pivot,graph</field></record>
</odoo>
