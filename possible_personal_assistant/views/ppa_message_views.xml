<odoo>
 <record id="ppa_message_view_list" model="ir.ui.view"><field name="name">ppa.message.list</field><field name="model">ppa.message</field><field name="arch" type="xml"><list><field name="name"/><field name="source_id"/><field name="subject"/><field name="sender_name"/><field name="direction"/><field name="received_at"/></list></field></record>
 <record id="ppa_message_view_form" model="ir.ui.view"><field name="name">ppa.message.form</field><field name="model">ppa.message</field><field name="arch" type="xml"><form><header><button name="action_analyze_with_ai" type="object" string="Analyze with AI" groups="possible_personal_assistant.group_ppa_user"/></header><sheet><group><field name="name"/><field name="source_id"/><field name="external_id"/><field name="conversation_id"/><field name="subject"/><field name="body"/></group><notebook><page string="Intelligence"><group><field name="ai_processed" readonly="1"/><field name="ai_summary" readonly="1"/><field name="ai_category" readonly="1"/><field name="ai_importance" readonly="1"/><field name="ai_confidence" readonly="1"/><field name="requires_reply" readonly="1"/><field name="requires_action" readonly="1"/></group><field name="ai_analysis_ids"><list><field name="processed_at"/><field name="status"/><field name="provider"/><field name="model"/><field name="prompt_version"/><field name="category"/><field name="importance"/><field name="confidence"/></list></field></page></notebook></sheet><chatter/></form></field></record>
 <record id="ppa_message_view_search" model="ir.ui.view"><field name="name">ppa.message.search</field><field name="model">ppa.message</field><field name="arch" type="xml"><search><field name="name"/><field name="subject"/><filter name="incoming" string="Incoming" domain="[('direction','=','incoming')]"/><filter name="outgoing" string="Outgoing" domain="[('direction','=','outgoing')]"/><filter name="requires_reply" string="Requires Reply" domain="[('requires_reply','=',True)]"/><filter name="requires_action" string="Requires Action" domain="[('requires_action','=',True)]"/><filter name="ai_processed" string="AI Processed" domain="[('ai_processed','=',True)]"/></search></field></record>
 <record id="ppa_message_action" model="ir.actions.act_window"><field name="name">Messages</field><field name="res_model">ppa.message</field><field name="view_mode">list,form,pivot,graph</field></record>
</odoo>
