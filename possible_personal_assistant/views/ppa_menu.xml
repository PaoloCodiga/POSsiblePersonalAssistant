<odoo>
 <record id="ppa_dashboard_action" model="ir.actions.act_window"><field name="name">Dashboard</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">pivot,graph,list</field></record>
 <record id="ppa_my_actions_action" model="ir.actions.act_window"><field name="name">My To-Do</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">list,form,kanban</field><field name="domain">[('suggested_user_id','=',uid)]</field></record>
 <record id="ppa_to_confirm_action" model="ir.actions.act_window"><field name="name">To Confirm</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">list,form,kanban</field><field name="domain">[('state','=','to_confirm')]</field></record>
 <record id="ppa_overdue_action" model="ir.actions.act_window"><field name="name">Overdue</field><field name="res_model">ppa.suggested.action</field><field name="view_mode">list,form,kanban</field><field name="domain">[('due_date','&lt;',context_today()),('state','not in',('completed','rejected'))]</field></record>
 <menuitem id="ppa_root_menu" name="POSsible Personal Assistant" groups="possible_personal_assistant.group_ppa_user" sequence="20"/>
 <menuitem id="ppa_dashboard_menu" name="Dashboard" parent="ppa_root_menu" action="ppa_dashboard_action" sequence="1"/>
 <menuitem id="ppa_my_work_menu" name="My Work" parent="ppa_root_menu" sequence="10"/>
 <menuitem id="ppa_my_actions_menu" name="My To-Do" parent="ppa_my_work_menu" action="ppa_my_actions_action"/>
 <menuitem id="ppa_to_confirm_menu" name="To Confirm" parent="ppa_my_work_menu" action="ppa_to_confirm_action"/>
 <menuitem id="ppa_overdue_menu" name="Overdue" parent="ppa_my_work_menu" action="ppa_overdue_action"/>
 <menuitem id="ppa_team_menu" name="Team" parent="ppa_root_menu" sequence="20"/><menuitem id="ppa_team_actions_menu" name="Team To-Do" parent="ppa_team_menu" action="ppa_suggested_action_action"/>
 <menuitem id="ppa_global_menu" name="Global" parent="ppa_root_menu" sequence="30"/><menuitem id="ppa_actions_menu" name="All Actions" parent="ppa_global_menu" action="ppa_suggested_action_action"/><menuitem id="ppa_decisions_menu" name="Decisions" parent="ppa_global_menu" action="ppa_decision_action"/>
 <menuitem id="ppa_communications_menu" name="Communications" parent="ppa_root_menu" sequence="40"/><menuitem id="ppa_conversations_menu" name="Conversations" parent="ppa_communications_menu" action="ppa_conversation_action"/><menuitem id="ppa_messages_menu" name="Messages" parent="ppa_communications_menu" action="ppa_message_action"/>
 <menuitem id="ppa_meetings_menu" name="Meetings" parent="ppa_root_menu" action="ppa_meeting_action" sequence="50"/>
 <menuitem id="ppa_configuration_menu" name="Configuration" parent="ppa_root_menu" groups="possible_personal_assistant.group_ppa_manager" sequence="90"/><menuitem id="ppa_sources_menu" name="Sources" parent="ppa_configuration_menu" action="ppa_source_action"/>
</odoo>
